# Copy this file to .env and fill in your own values. .env is gitignored.

# Free key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-api-key

# PostgreSQL connection for the census_data database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://localhost:5432/census_data

# Alternative: leave DATABASE_URL unset and use the standard libpq variables instead.
# PGHOST=localhost
# PGPORT=5432
# PGUSER=your-user
# PGPASSWORD=
# PGDATABASE=census_data
